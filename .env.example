# ========================================
# CONFIGURAÇÕES DA API DO GOOGLE
# ========================================
# Chave de API do Google Generative AI
GOOGLE_API_KEY=sua_chave_google_aqui

# Modelo para embeddings (não alterar sem necessidade)
GOOGLE_EMBEDDING_MODEL=models/embedding-001

# ========================================
# CONFIGURAÇÕES DO OPENAI (OPCIONAL)
# ========================================
# Caso prefira usar OpenAI em vez do Google
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ========================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ========================================
# URL de conexão com PostgreSQL + pgvector
# Linux/Mac
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag

# Nome da coleção de vetores no banco
PG_VECTOR_COLLECTION_NAME=gpt5_collection

# ========================================
# CONFIGURAÇÕES DO DOCUMENTO
# ========================================
# Caminho absoluto para o arquivo PDF a ser processado
# Exemplo: /home/usuario/projeto/document.pdf
PDF_PATH=/caminho/absoluto/para/seu/document.pdf